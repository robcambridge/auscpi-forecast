# Copy to .env and fill in. .env is gitignored.

# NSW FuelCheck — register free at https://api.nsw.gov.au/Product/Index/22
FUELCHECK_API_KEY=
FUELCHECK_API_SECRET=

# Optional: Anthropic key for the policy-event extraction layer (Phase 3)
ANTHROPIC_API_KEY=

# Where data lives. Leave blank to use ./data
AUSCPI_DATA_DIR=
